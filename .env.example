# Copy to .env.local. Server-only: none of these are exposed to the browser.

# Base URL of the Express API, including the version prefix.
BACKEND_API_URL=http://localhost:4000/api/v1

# Same value as BFF_SHARED_SECRET in the API. Lets its rate limits see the browser IP behind Vercel.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BFF_SHARED_SECRET=
